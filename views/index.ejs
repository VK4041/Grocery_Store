<!DOCTYPE html>
<html lang="en">
  <%- include("partials/head.ejs") %>
  <body>
    <h1 class="capitalize"><%= locals.title %></h1>
    <div class="cat-list">
      <% locals.categories.forEach(category=>{ %>
      <button class="cat-item capitalize">
        <a href="/cat/<%= category.id %>">
          <%= category.name %>
        </a>
      </button>
      <% }) %>
      <button class="cat-item">
        <a href="/cat">Uncategorized</a>
      </button>
    </div>
    <form action="/cat/create" method="GET">
      <button class="button">Create New Category</button>
    </form>
  </body>
</html>
