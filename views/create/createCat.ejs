<!DOCTYPE html>
<html lang="en">
  <%- include("../partials/head.ejs") %>
  <body>
    <h1><%= locals.title %></h1>
    <form class="form" action="/cat/create" method="POST">
      <div class="input-row">
        <label for="catName">Category Name</label>
        <input type="text" required name="catName" />
      </div>
      <div class="input-row">
        <label for="catDesc">Category Description</label>
        <input type="text" name="catDesc" />
      </div>
      <div class="input-row">
        <button class="create-btn" type="submit">Create</button>
      </div>
    </form>
    <div class="nav-link">
      <a class="home-link" href="/">Home</a>
    </div>
  </body>
</html>
