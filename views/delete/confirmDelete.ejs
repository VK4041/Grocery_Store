<!DOCTYPE html>
<html lang="en">
  <%- include("../partials/head.ejs") %>
  <body>
    <div class="confirm-delete">
      <p>Do you want to delete this <%= type==='cat'? 'Category':'Item' %>?</p>
      <% if(type === 'cat') { %>
        <p>Note: Deleting this category will shift all of its items under 'Uncategorized' category</p>
      <% } %>
      <form action="/<%= type %>/delete/<%= id %>" method="POST">
        <button type="submit" class="button delete-btn">Yes</button>
        <a class="button" href="/<%= type %>/<%= id %>" autofocus>No</a> 
        <!-- This doesn't submit and redirects the page -->
      </form>
    </div>
  </body>
</html>
