<!DOCTYPE html>
<html lang="en">
  <%- include("../partials/head.ejs") %>
  <body>
    <h1><%= title %></h1>
    <form class="form" action="/cat/update/<%= cat_id %>" method="POST">
      <div class="input-row">
        <label for="catName">Cat Name</label>
        <input type="text" required name="catName" value="<%= name %>" />
      </div>
      <div class="input-row">
        <label for="catDesc">Category Description</label>
        <input type="text" name="catDesc" value="<%= description %>" />
      </div>
      <div class="input-row">
        <button class="button submit-btn" type="submit">Update</button>
      </div>
      <input type="hidden" name="cat_id" value="<%= cat_id %>" />
    </form>
    <div class="nav-link">
      <a class="home-link" href="/">Home</a>
    </div>
  </body>
</html>
