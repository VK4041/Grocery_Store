<!DOCTYPE html>
<html lang="en">
  <%- include("partials/head.ejs") %>
  <body>
    <h1 class="capitalize">Name: <%= locals.title %></h1>
    <p class="item-desc">Description: <%= locals.desc %></p>
    <p class="item-stock">Stock Level: <%= locals.stock %></p>
    <p class="item-price">Price: $<%= locals.price %>/-</p>
    <form action="/item/update/<%= locals.itemId%>" method="GET">
      <button class="button">Update</button>
    </form>
    <form action="/item/delete/<%= locals.itemId %>" method="GET">
      <button class="button delete-btn">Delete</button>
    </form>
    <div class="nav-link">
      <a class="home-link" href="/cat/<%= locals.cat_id %>">Back</a>
      <a class="home-link" href="/">Home</a>
    </div>
  </body>
</html>
