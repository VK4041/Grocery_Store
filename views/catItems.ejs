<!DOCTYPE html>
<html lang="en">
  <%- include("partials/head.ejs") %>
  <body>
    <h1 class="capitalize"><%= locals.title %></h1>
    <% if( type === 'categorized'){ %> 
      <p class="cat-desc"><%= locals.catDesc %></p>
    <% } %>
      <p class="cat-numitems">Number of Items: <%= locals.numItems %></p>
    <% if( type === 'categorized'){ %>
      <form action="/cat/update/<%= locals.cat_id %>" method="GET">
        <button class="button">Update Category</button>
      </form>
      <form action="/cat/delete/<%= locals.cat_id %>" method="GET">
        <button class="button delete-btn">Delete</button>
      </form>
    <% } %>
    <div class="item-list">
    <% locals.items.forEach(item=>{ %>
      <a href="/item/<%= item.id %>">
        <div class="item-card">
          <p class="item-name capitalize"><%= item.name %></p>
          <p class="item-price">$<%= item.price %>/-</p>
        </div>
      </a>
    <% }) %>
    </div>
    <% if( type === 'categorized'){ %> 
      <form action="/item/create/<%= locals.cat_id %>" method="GET">
        <button class="button">Add New Item</button>
      </form>
    <% } %>
    <div class="nav-link">
      <a class="home-link" href="/">Home</a>
    </div>
    
  </body>
</html>
